; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=30

[application]

config/name="G-Drive"
run/main_scene="uid://dexp0d75btgj0"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=30
boot_splash/image="uid://bllvjdvktpodv"
config/icon="uid://bllvjdvktpodv"
boot_splash/minimum_display_time=3000

[editor_plugins]

enabled=PackedStringArray("res://addons/physics_collision_import_generator/plugin.cfg")

[gui]

