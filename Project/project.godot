; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=30

[application]

config/name="Golf"
config/version="4.41"
run/main_scene="uid://dqy35w0t0uaa0"
run/print_header=false
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=30
boot_splash/bg_color=Color(0.772549, 0.662745, 0.415686, 1)
boot_splash/fullsize=false
boot_splash/image="uid://bllvjdvktpodv"
config/icon="uid://bllvjdvktpodv"
boot_splash/minimum_display_time=3000

[display]

window/size/viewport_width=1280
window/size/mode=2
window/size/initial_position_type=4
window/size/initial_position=Vector2i(-1, -1)
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=false
window/vsync/vsync_mode=0

[editor]

movie_writer/fps=30

[editor_plugins]

enabled=PackedStringArray("res://addons/physics_collision_import_generator/plugin.cfg")

[gui]

theme/custom="res://Themes/MinimalUI44/MinimalUI.tres"
theme/custom_font="uid://kxpkpf1fnb1i"
theme/default_font_antialiasing=2

[importer_defaults]

3d_texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": true,
"compress/lossy_quality": 0.7,
"compress/mode": 2,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"slices/horizontal": 8,
"slices/vertical": 8
}
texture={
