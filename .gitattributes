# Normalize EOL for all files that Git considers text files
* text=auto eol=lf
*.zip filter=lfs diff=lfs merge=lfs -text
Export/* filter=lfs diff=lfs merge=lfs -text
Export/Golf.console.exe filter=lfs diff=lfs merge=lfs -text
Export/Golf.exe filter=lfs diff=lfs merge=lfs -text
Export/Golf.pck filter=lfs diff=lfs merge=lfs -text
